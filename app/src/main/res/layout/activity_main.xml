<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUMP Сигнал"
            android:textColor="#F0F6FC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Монитор остановлен"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDeepSeekPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="#10251C"
            android:minHeight="68dp"
            android:padding="9dp"
            android:text="DEEPSIG • ОСНОВНОЙ • ожидает первый анализ"
            android:textColor="#7EE787"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeepSeekActionLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="#3A171A"
            android:gravity="center"
            android:minHeight="116dp"
            android:padding="10dp"
            android:text="DEEPSIG • ГОТОВНОСТЬ ВХОДА\n1/10 • НЕ ВХОДИТЬ\nЖдём свежий подтверждённый анализ"
            android:textColor="#FF7B72"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCriticalOverview"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#9A6700"
            android:text="КРИТИЧЕСКИЙ ОБЗОР • СТАКАН | ПОТОКИ | BTC"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBuyerBreathSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="#161B22"
            android:lineSpacingExtra="2dp"
            android:minHeight="106dp"
            android:padding="11dp"
            android:text="ДЫХАНИЕ РЫНКА • ждём живой поток"
            android:textColor="#C9D1D9"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnBuyerBreath"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#0F6B78"
            android:text="ОТКРЫТЬ ГРАФИК • ВДОХ | РАЗГОН | ВЫДЫХАНИЕ"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLatestSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="#172033"
            android:minHeight="86dp"
            android:padding="10dp"
            android:text="ПОСЛЕДНИЙ СИГНАЛ\nПока сигналов нет"
            android:textColor="#DDE7F7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="#30363D"
            android:gravity="center"
            android:text="ЖДЁМ НОВЫЙ ВХОД СНИЗУ"
            android:textColor="#C9D1D9"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReadiness"
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginTop="10dp"
            android:background="#161B22"
            android:gravity="center"
            android:padding="8dp"
            android:text="ГОТОВНОСТЬ СИГНАЛА 0/100"
            android:textColor="#C9D1D9"
            android:maxLines="3"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRapidDrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#8E1519"
            android:gravity="center"
            android:minHeight="92dp"
            android:padding="10dp"
            android:text="АВАРИЙНОЕ ПАДЕНИЕ PUMP/EUR"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAppPaper"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:backgroundTint="#238636"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="3"
                    android:padding="2dp"
                    android:text="APP&#10;€1 000,00&#10;+0,00%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGeminiExperiment"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7C3AED"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="3"
                    android:padding="2dp"
                    android:text="DEEPSIG&#10;€1 000,00&#10;+0,00%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGeminiExitExperiment"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:backgroundTint="#9A6700"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="3"
                    android:padding="2dp"
                    android:text="DEEPSIGX&#10;€1 000,00&#10;+0,00%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUserPaper"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1F6FEB"
                    android:includeFontPadding="false"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="3"
                    android:padding="2dp"
                    android:text="СЕРЖ&#10;€1 000,00&#10;+0,00%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnFusionSim"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="5dp"
                android:backgroundTint="#0F6B78"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="3"
                android:padding="2dp"
                android:text="DEEPSIG FUSION • READ-ONLY SIM&#10;€1 000,00&#10;+0,00%"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCompetition"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#1F6FEB"
            android:text="СРАВНИТЬ 4 • APP | DEEPSIG | DEEPSIGX | FUSION"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#161B22"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PUMP цена - | RSI -"
                android:textColor="#F0F6FC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Нажмите ЗАПУСТИТЬ"
                android:textColor="#8B949E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Позиция: нет"
                android:textColor="#C9D1D9"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvManualPnl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#101820"
                android:gravity="center"
                android:minHeight="86dp"
                android:padding="8dp"
                android:text="МОЯ ПОЗИЦИЯ НЕ ОТКРЫТА"
                android:textColor="#79C0FF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPositionSupervisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#201522"
                android:lineSpacingExtra="3dp"
                android:minHeight="240dp"
                android:padding="14dp"
                android:text="DEEPSIG • ожидает открытия позиции"
                android:textColor="#D2A8FF"
                android:textIsSelectable="true"
                android:textSize="16sp" />

            <com.example.pumppaperbot.ManualPositionChartView
                android:id="@+id/manualPositionChart"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnManualHistory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#30363D"
                android:text="ИСТОРИЯ МОИХ СДЕЛОК • 6 МЕС."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ОБЩИЙ ГРАФИК РЫНКА • НАЖМИТЕ ДЛЯ 6 МЕС."
                android:textColor="#58A6FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnChartSpeed"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="#1F6FEB"
                android:gravity="center"
                android:maxLines="2"
                android:padding="5dp"
                android:text="СКОРОСТЬ ГРАФИКА • 30 МИНУТ&#10;НАЖМИТЕ, ЧТОБЫ ИЗМЕНИТЬ"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.example.pumppaperbot.StrategyChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBitpandaFusion"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:backgroundTint="#0F6B78"
                android:gravity="center"
                android:maxLines="4"
                android:padding="3dp"
                android:text="BITPANDA FUSION&#10;READ-ONLY API&#10;открыть центр"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnUnifiedLog"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1F6FEB"
                android:gravity="center"
                android:maxLines="4"
                android:padding="3dp"
                android:text="ЕДИНЫЙ ЛОГ&#10;4 АГЕНТА&#10;экспорт JSON"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBreathingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#172033"
            android:gravity="center"
            android:minHeight="58dp"
            android:padding="8dp"
            android:text="ДЫХАНИЕ: НЕДОСТАТОЧНО ДАННЫХ"
            android:textColor="#79C0FF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEnergy"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:gravity="center"
                android:padding="3dp"
                android:text="АКТИВНОСТЬ\n0/100"
                android:textColor="#F0B72F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDirection"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:gravity="center"
                android:padding="3dp"
                android:text="ПОТОК\n0/100"
                android:textColor="#C9D1D9"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:gravity="center"
                android:padding="3dp"
                android:text="СОГЛАСОВАНО\n0/100"
                android:textColor="#79C0FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLateRisk"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="#161B22"
                android:gravity="center"
                android:padding="3dp"
                android:text="ПОЗДНИЙ ВХОД\n0/100"
                android:textColor="#7EE787"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMicrostructure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="#161B22"
            android:padding="7dp"
            android:text="Стакан и открытый интерес: ждём данные"
            android:textColor="#8B949E"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRisk30"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_weight="1"
                android:backgroundTint="#30363D"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="3"
                android:padding="4dp"
                android:text="СТРОГИЙ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRisk35"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#238636"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="3"
                android:padding="4dp"
                android:text="ЧУВСТВИТЕЛЬНЫЙ"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#161B22"
            android:padding="10dp"
            android:text="Звонок: ежедневно 06:15–23:00"
            android:textColor="#C9D1D9"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAlertSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1F6FEB"
            android:text="ЗВОНКИ И РАСПИСАНИЕ"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDeepSeekApi"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:backgroundTint="#174D2A"
                android:gravity="center"
                android:maxLines="4"
                android:padding="3dp"
                android:text="DEEPSIG API&#10;ОСНОВНОЙ&#10;открыть центр"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGeminiApi"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#5B318F"
                android:gravity="center"
                android:maxLines="4"
                android:padding="3dp"
                android:text="GEMINI API&#10;РУЧНОЕ МНЕНИЕ&#10;открыть центр"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:backgroundTint="#238636"
                android:text="ЗАПУСТИТЬ"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCheck"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1F6FEB"
                android:text="ПРОВЕРИТЬ"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:backgroundTint="#6E7681"
                android:text="СТОП"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#DA3633"
                android:text="СБРОС"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnManualBuy"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:backgroundTint="#238636"
                android:text="Я КУПИЛ"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManualSell"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#DA3633"
                android:enabled="false"
                android:text="Я ПРОДАЛ"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBacktest"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2F81F7"
            android:text="ТЕСТ НАЗАД"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
